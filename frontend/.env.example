# ============================================================
# FAKENIX 2.0 — Frontend Environment Variables
# Copy this file to .env (for local dev) or configure in Vercel Project Settings
# ============================================================

# ─────────────────────────────────────────────────────────────
# BACKEND API URL
# ─────────────────────────────────────────────────────────────
# For local development with backend on port 5000:
VITE_API_BASE_URL=http://localhost:5000/api

# For Vercel production deployment connected to Render backend:
# VITE_API_BASE_URL=https://your-fakenix-backend.onrender.com/api

# ─────────────────────────────────────────────────────────────
# APPLICATION BRANDING
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME=FAKENIX
