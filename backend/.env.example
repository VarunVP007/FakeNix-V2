# ============================================================
# FAKENIX 2.0 — Backend Environment Variables
# Copy this file to .env (for local dev) or configure in Render Dashboard
# NEVER commit the .env file — it contains real secrets.
# ============================================================

# ─────────────────────────────────────────────────────────────
# FLASK & SERVER
# ─────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_value_at_least_32_chars
PORT=5000
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# SQLite (development default — no setup required):
DATABASE_URL=sqlite:///fakenix_dev.db

# PostgreSQL (Render Managed Database or Neon / Supabase):
# Note: Both postgresql:// and postgres:// are supported (automatically normalized)
# DATABASE_URL=postgresql://user:password@dpg-xxxxx.oregon-postgres.render.com/fakenix_db

# MySQL:
# DATABASE_URL=mysql+pymysql://fakenix_user:password@localhost/fakenix_db

# ─────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_another_secure_random_value_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# ─────────────────────────────────────────────────────────────
# FRONTEND / CORS
# ─────────────────────────────────────────────────────────────
# Set to your deployed Vercel frontend URL in production:
FRONTEND_URL=http://localhost:5173
# Optional comma-separated list of additional allowed origins:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# DEMO MODE
# Set to true for hackathon evaluation and simulated fallback
# Set to false in full production with live Groq AI analysis
# ─────────────────────────────────────────────────────────────
DEMO_MODE=true

# ─────────────────────────────────────────────────────────────
# AI ANALYSIS — Groq vision LLM
# Live vision model analysis (e.g. qwen/qwen3.8-27b)
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=90
GROQ_VIDEO_FRAMES=2

# ─────────────────────────────────────────────────────────────
# FILE UPLOAD LIMITS & STORAGE
# ─────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=storage/uploads
REPORT_FOLDER=storage/reports
PROCESSED_FOLDER=storage/processed
EVIDENCE_FOLDER=storage/evidence

# ─────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
